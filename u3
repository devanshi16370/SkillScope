# View skills demand
def view_demand_skill():
    conn = sqlite3.connect('SkillScope.db')
    cursor = conn.cursor()
    cursor.execute("SELECT * FROM jobs")
    data = cursor.fetchall()
    skills_count = {}

    for row in data:
        skills = row[6].split(',')
        for skill in skills:
            skill = skill.strip()
            skills_count[skill] = skills_count.get(skill, 0) + 1

    plt.figure(figsize=(30, 30))
    plt.pie(skills_count.values(), labels=skills_count.keys(), autopct='%0.2f%%',
            startangle=0, colors=plt.cm.Paired.colors)
    plt.title("Skills in Demand")
    plt.axis('equal')
    plt.show()

# View jobs demand
def view_demand_jobs():
    conn = sqlite3.connect('SkillScope.db')
    cursor = conn.cursor()
    cursor.execute("SELECT * FROM jobs")
    data = cursor.fetchall()
    job_count = {}

    for row in data:
        skills = row[2].split(',')
        for skill in skills:
            skill = skill.strip()
            job_count[skill] = job_count.get(skill, 0) + 1

    plt.figure(figsize=(30, 30))
    plt.pie(job_count.values(), labels=job_count.keys(), autopct='%0.2f%%',
            startangle=0, colors=plt.cm.Paired.colors)
    plt.title("Jobs in Demand")
    plt.axis('equal')
    plt.show()

